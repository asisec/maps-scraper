{
    "env": {
        "browser": true,
        "es6": true
    },
    "extends": "eslint:recommended",
    "globals": {
        "angular": "readonly",
        "google": "readonly",
        "L": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 2018
    },
    "rules": {
        "no-console": "warn",
        "no-unused-vars": "warn",
        "eqeqeq": "error",
        "no-var": "error",
        "prefer-const": "warn",
        "semi": ["error", "always"]
    }
}