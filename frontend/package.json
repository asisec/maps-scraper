{
  "name": "maps-scraper-frontend",
  "version": "1.0.0",
  "description": "Maps Scraper AngularJS Frontend",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "build": "node -e \"const fs=require('fs'); fs.mkdirSync('dist', {recursive:true}); fs.cpSync('app', 'dist/app', {recursive:true}); fs.copyFileSync('index.html', 'dist/index.html');\"",
    "lint": "eslint app/**/*.js"
  },
  "dependencies": {
    "angular": "^1.8.3",
    "angular-route": "^1.8.3",
    "bootstrap": "^5.3.3",
    "@fortawesome/fontawesome-free": "^6.5.2"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}